{#- Expects `source`, `withPlayer` when the whole video should be playable here, and `check`
    when the monthly check found the original gone or changed (see tools/check-sources.js). -#}
{%- set gone = check and check.status == "gone" %}
<aside class="source-card h-cite" aria-label="What this responds to">
  {%- if withPlayer %}{{ source | sourcePlayer | safe }}{% endif %}
  {%- if source.text %}
  <blockquote class="source-text p-content" cite="{{ source.url }}">{{ source.text | sourceText | safe }}</blockquote>
  {%- endif %}
  <p class="source-title"><span class="source-type">{{ source.type | sourceType }}</span> <a class="p-name u-url" href="{{ source.archived if (gone and source.archived) else source.url }}" rel="noopener"{% if source.archived %} data-versionurl="{{ source.archived }}"{% if source.archivedOn %} data-versiondate="{{ source.archivedOn | isoDate }}"{% endif %}{% endif %}>{{ source.title }}</a></p>
  {%- if source.author or source.site or source.published %}
  <p class="source-meta">
    {%- for person in source.author | people %}<a class="p-author h-card" href="{{ person | personUrl }}">{{ person }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
    {%- if source.author and (source.site or source.published) %}, {% endif %}
    {%- if source.site %}<a class="p-publication" href="{{ source.site | siteUrl }}">{{ source.site }}</a>{% endif %}
    {%- if source.site and source.published %}, {% endif %}
    {%- if source.published %}<time class="dt-published" datetime="{{ source.published | isoDate }}">{{ source.published | readableDate }}</time>{% endif %}
  </p>
  {%- endif %}
  {%- if check %}
  <p class="source-check">
    {%- if gone %}The original is no longer at its address{% if source.archived %}, so the title links to the saved copy{% endif %}.
    {%- else %}The original has changed since this was written{% if source.archived %}; the saved copy shows it as it was{% endif %}.{% endif %}
  </p>
  {%- endif %}
  {%- if source.archived %}
  <p class="source-archive"><a href="{{ source.archived }}" rel="noopener" data-originalurl="{{ source.url }}"{% if source.archivedOn %} data-versiondate="{{ source.archivedOn | isoDate }}"{% endif %}>Saved copy{% if source.archivedOn %} from {{ source.archivedOn | readableDate }}{% endif %}</a></p>
  {%- endif %}
</aside>
