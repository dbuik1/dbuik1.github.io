---
layout: layouts/base.njk
---
<section class="intro">
  <h1>{{ "home-intro" | siteText | safe }}</h1>
  {{ "home-about" | siteText | safe }}
</section>

{#- Each section appears once it has something in it, so visitors never land on an empty list. -#}
{%- if collections.posts | length %}
<section class="home-section">
  <h2>Recent writing</h2>
  {%- set postList = collections.posts | head(5) %}
  {% include "partials/post-list.njk" %}
  {%- if collections.posts | length > postList | length %}
  <p class="more"><a href="/blog/">All writing</a></p>
  {%- endif %}
</section>
{%- endif %}

{%- set active = collections.projects | byStatus("active") %}
{%- if active | length %}
<section class="home-section">
  <h2>Working on</h2>
  {%- set projectList = active %}
  {% include "partials/project-list.njk" %}
  {%- if collections.projects | length > active | length %}
  <p class="more"><a href="/projects/">All projects</a></p>
  {%- endif %}
</section>
{%- endif %}
