{
  "name": "davidbuik.com",
  "private": true,
  "type": "module",
  "description": "Personal website of David Buik, built with Eleventy.",
  "scripts": {
    "start": "npm run build && eleventy --serve",
    "build": "eleventy && pagefind --site _site",
    "write": "node editor/server.js",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-doi": "^0.9.0",
    "@citation-js/plugin-isbn": "^0.5.0",
    "@sindresorhus/slugify": "^2.2.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "chokidar": "file:tools/chokidar-globs",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.2",
    "markdown-it-footnote": "^4.0.0",
    "pagefind": "^1.5.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "chokidar": "$chokidar",
    "gray-matter": {
      "js-yaml": "^4.1.0"
    }
  }
}
