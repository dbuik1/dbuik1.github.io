---
layout: layouts/page.njk
title: Research levels
eleventyComputed:
  description: "{{ ('levels-intro' | siteText | excerpt) or 'What the research levels on David Buik’s site mean.' }}"
permalink: /levels/
---
{{ "levels-intro" | siteText | safe }}
{%- for l in levels %}
{%- set count = collections["level-" + l.slug] | length %}
<section class="level-group" id="{{ l.slug }}" aria-labelledby="level-{{ l.slug }}">
  <h2 id="level-{{ l.slug }}">{% if count %}<a href="/blog/{{ l.slug }}/">{{ l.name }}</a> <span class="count">{{ count }}</span>{% else %}{{ l.name }}{% endif %}</h2>
  <p>{{ ("level-" + l.slug) | siteText | safe }}</p>
</section>
{%- endfor %}
