{#- Expects `postList`. One line per idea: the phrase, then its date. -#}
{%- if postList | length %}
<ul class="seed-list">
  {%- for p in postList %}
  <li>
    <a href="{{ p.url }}">{{ p.data.title }}</a>
    <time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time>
    {%- if p.data.draft %} <span class="draft">Draft</span>{% endif %}
  </li>
  {%- endfor %}
</ul>
{%- else %}
<p class="empty">None yet.</p>
{%- endif %}
