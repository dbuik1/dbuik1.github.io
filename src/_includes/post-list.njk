{%- if postList | length %}
<ul class="post-list">
  {%- for post in postList %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
  </li>
  {%- endfor %}
</ul>
{%- else %}
<p class="empty">Nothing published yet. Posts will appear here.</p>
{%- endif %}
