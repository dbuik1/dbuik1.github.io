  {{ "colophon-notes" | siteText | safe }}
</section>

<section class="colophon-section" aria-labelledby="commentary">
  <h2 id="commentary"><a href="/commentary/">Commentary</a></h2>
  {{ "colophon-commentary" | siteText | safe }}
</section>

<section class="colophon-section" aria-labelledby="visuals">
