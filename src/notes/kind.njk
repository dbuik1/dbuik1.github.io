---
layout: layouts/page.njk
pagination:
  data: collections.noteKinds
  size: 1
  addAllPagesToCollections: true
  alias: kind
permalink: "{{ kind.url }}"
eleventyComputed:
  title: "Notes: {{ kind.name }}"
  description: "Notes of the kind “{{ kind.name }}” kept by David Buik."
---
<nav class="filters" aria-label="Kinds of note">
  <a href="/notes/">All</a>
  {%- for k in collections.noteKinds %}
  <a href="{{ k.url }}"{% if k.name == kind.name %} aria-current="page"{% endif %}>{{ k.name }} <span class="count">{{ k.count }}</span></a>
  {%- endfor %}
</nav>
{%- set noteList = collections.notes | byKind(kind.name) %}
{% include "partials/note-list.njk" %}
