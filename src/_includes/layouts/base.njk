<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.title }}</title>
{% include "partials/seo.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <link rel="stylesheet" href="/css/style.css">
  <script>try { if (localStorage.getItem("annotation-mode") === "compact" && "showPopover" in HTMLElement.prototype) document.documentElement.dataset.annotations = "compact"; } catch (e) {}</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site">
    <header class="site-header">
      <a class="site-name" href="/">{{ site.title }}</a>
      {%- if site.nav | length > 1 %}
      <nav aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          {%- if item.children %}
          {%- set inside = false %}
          {%- for child in item.children %}{% if page.url.startsWith(child.url) %}{% set inside = true %}{% endif %}{% endfor %}
          <li>
            <details class="menu">
              <summary{% if inside %} class="is-current"{% endif %}>{{ item.label }}</summary>
              <ul>
                {%- for child in item.children %}
                {%- if not child.hideWhenEmpty or collections[child.hideWhenEmpty] | length %}
                <li><a href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
                {%- endif %}
                {%- endfor %}
              </ul>
            </details>
          </li>
          {%- else %}
          <li><a href="{{ item.url }}"{% if item.url == page.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </nav>
      {%- endif %}
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>© {{ year }} {{ site.author }}</span>
      <nav aria-label="Site">
        {%- for item in site.footer %}
        <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </footer>
  </div>
  <script>
    // Menus close on Escape, on a click elsewhere, and when another one opens.
    (function () {
      var menus = document.querySelectorAll("details.menu");
      function closeAll(except) { menus.forEach(function (m) { if (m !== except) m.open = false; }); }
      menus.forEach(function (m) { m.addEventListener("toggle", function () { if (m.open) closeAll(m); }); });
      document.addEventListener("click", function (e) { if (!e.target.closest("details.menu")) closeAll(); });
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        var open = document.querySelector("details.menu[open]");
        if (open) { open.open = false; open.querySelector("summary").focus(); }
      });
    })();
  </script>
  {%- if 'class="visual' in content %}
  <script src="/js/visuals.js" defer></script>
  {%- endif %}
  {%- if 'class="xref"' in content %}
  <script src="/js/xref.js" defer></script>
  {%- endif %}
</body>
</html>
