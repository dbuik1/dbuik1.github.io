{
  "manifest_version": 3,
  "name": "Commentary capture",
  "version": "1.0.0",
  "description": "Capture the page, video or post you're on for a commentary on davidbuik.com.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture for commentary",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+C" } }
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8081/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "minimum_chrome_version": "116"
}
