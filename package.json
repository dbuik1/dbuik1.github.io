{
  "name": "davidbuik.com",
  "private": true,
  "type": "module",
  "description": "Personal website of David Buik, built with Eleventy.",
  "scripts": {
    "start": "npm run build && ELEVENTY_ENV=development eleventy --serve",
    "build": "eleventy && pagefind --site _site",
    "write": "node editor/server.js",
    "clean": "rm -rf _site"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "chokidar": "file:tools/chokidar-globs",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.2",
    "pagefind": "^1.5.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "chokidar": "$chokidar",
    "gray-matter": {
      "js-yaml": "^4.1.0"
    }
  }
}
