---
layout: layouts/base.njk
---
{%- set st = statuses | byField("slug", status) | first %}
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <span class="post-meta">
      {%- if st %}<span class="status status-{{ st.slug }}">{{ st.name }}</span>{% endif %}
      {%- if draft %}<span class="draft">Draft</span>{% endif %}
    </span>
    {%- if summary %}<p class="summary">{{ summary }}</p>{% endif %}
    {%- if links and links | length %}
    <ul class="project-links">
      {%- for l in links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}
    </ul>
    {%- endif %}
  </header>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <section class="home-section">
    <h2>Writing about this project</h2>
    {%- set postList = collections.posts | byProject(page.fileSlug) %}
    {% include "partials/post-list.njk" %}
  </section>
</article>

<nav class="post-nav" aria-label="More projects">
  <a href="/projects/">All projects</a>
</nav>
