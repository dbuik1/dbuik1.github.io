  <p>{{ ("level-" + l.slug) | siteText | safe }}</p>
  {%- endfor %}
</section>

<section class="colophon-section" aria-labelledby="importance">
  <h2 id="importance">Importance</h2>
  {{ "colophon-importance" | siteText | safe }}
</section>

<section class="colophon-section" aria-labelledby="notes">
